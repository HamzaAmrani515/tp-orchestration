{
  "info": {
    "name": "ecommerce-platform-secured",
    "_postman_id": "b0e9b7a5-7e2e-4a4e-a7b9-8d7d6c9d0001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "membershipBaseUrl", "value": "http://localhost:8081" },
    { "key": "productBaseUrl", "value": "http://localhost:8082" },
    { "key": "orderBaseUrl", "value": "http://localhost:8083" },
    { "key": "token", "value": "" },
    { "key": "memberId", "value": "1" },
    { "key": "productId", "value": "1" }
  ],
  "item": [
    {
      "name": "1) Login (get token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "*/*" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo.member@test.com\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{membershipBaseUrl}}/api/v1/auth/login",
          "host": ["{{membershipBaseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2) Product - GET /products (with token => 200)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "*/*" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{productBaseUrl}}/api/v1/products",
          "host": ["{{productBaseUrl}}"],
          "path": ["api", "v1", "products"]
        }
      }
    },
    {
      "name": "3) Product - GET /products (no token => 401)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "*/*" }],
        "url": {
          "raw": "{{productBaseUrl}}/api/v1/products",
          "host": ["{{productBaseUrl}}"],
          "path": ["api", "v1", "products"]
        }
      }
    },
    {
      "name": "4) Create Product (with token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "*/*" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Pc\",\n  \"description\": \"test\",\n  \"category\": \"IT\",\n  \"price\": 100,\n  \"quantity\": 10,\n  \"active\": true\n}"
        },
        "url": {
          "raw": "{{productBaseUrl}}/api/v1/products",
          "host": ["{{productBaseUrl}}"],
          "path": ["api", "v1", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.id) pm.collectionVariables.set('productId', String(json.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "5) Membership - GET /members (with token)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "*/*" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{membershipBaseUrl}}/api/v1/members",
          "host": ["{{membershipBaseUrl}}"],
          "path": ["api", "v1", "members"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const arr = pm.response.json();",
              "if (Array.isArray(arr) && arr.length > 0 && arr[0].id) pm.collectionVariables.set('memberId', String(arr[0].id));"
            ]
          }
        }
      ]
    },
    {
      "name": "6) Create Order (with token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "*/*" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"memberId\": {{memberId}},\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}"
        },
        "url": {
          "raw": "{{orderBaseUrl}}/api/v1/orders",
          "host": ["{{orderBaseUrl}}"],
          "path": ["api", "v1", "orders"]
        }
      }
    }
  ]
}